/** Kristoffer Carlin backend foundation. Configure Script Properties before use.
 * Required Script Property: SPREADSHEET_ID. Drive folder IDs will be added when gallery upload is implemented.
 * This starter does not claim production-ready auth or reservation locking.
 */
const P=PropertiesService.getScriptProperties();
function doGet(e){try{const action=String(e?.parameter?.action||'');if(action==='health')return out_({ok:true,configured:!!P.getProperty('SPREADSHEET_ID')});if(['events','blog','gallery','testimonials'].includes(action))return out_({ok:true,[action]:readPublic_(action,e.parameter.lang||'no')});return out_({ok:false,error:'Unsupported action'});}catch(err){return out_({ok:false,error:'Server error'});}}
function doPost(e){let b;try{b=JSON.parse(e?.postData?.contents||'{}')}catch(_){return out_({ok:false,error:'Invalid request'})}if(b.action==='contact')return saveContact_(b);return out_({ok:false,error:'Action not enabled'});}
function readPublic_(kind,lang){const ss=sheetDb_();const config={events:['Workshops','published'],blog:['Blog','published'],gallery:['Gallery','published'],testimonials:['Testimonials','published']}[kind];const sh=ss.getSheetByName(config[0]);if(!sh||sh.getLastRow()<2)return [];const values=sh.getDataRange().getDisplayValues();const headers=values.shift();return values.map(row=>Object.fromEntries(headers.map((h,i)=>[h,row[i]]))).filter(r=>String(r.status||r.published||'').toLowerCase()==='published'||String(r.published||'').toLowerCase()==='true').map(r=>{if(kind==='events')return{id:r.id,title:lang==='en'&&r.title_en?r.title_en:r.title_no,summary:lang==='en'&&r.summary_en?r.summary_en:r.summary_no,dateLabel:lang==='en'&&r.date_label_en?r.date_label_en:r.date_label_no,bookingUrl:r.booking_url||'#contact'};if(kind==='blog')return{id:r.id,title:lang==='en'&&r.title_en?r.title_en:r.title_no,summary:lang==='en'&&r.summary_en?r.summary_en:r.summary_no,url:r.slug?'blog.html?slug='+encodeURIComponent(r.slug):''};if(kind==='gallery')return{id:r.id,imageUrl:r.image_url||'',alt:lang==='en'&&r.alt_en?r.alt_en:r.alt_no||''};return{id:r.id,name:r.name_or_initials,text:lang==='en'&&r.text_en?r.text_en:r.text_no};}).filter(x=>kind!=='gallery'||x.imageUrl);}
function saveContact_(b){const name=clean_(b.name,160),email=clean_(b.email,254),message=clean_(b.message,5000);if(!name||!message||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))return out_({ok:false,error:'Invalid contact fields'});const ss=sheetDb_();let sh=ss.getSheetByName('ContactMessages');if(!sh){sh=ss.insertSheet('ContactMessages');sh.appendRow(['created_at','name','email','message','language','status'])}sh.appendRow([new Date(),name,email,message,b.lang==='en'?'en':'no','new']);return out_({ok:true});}
function sheetDb_(){const id=P.getProperty('SPREADSHEET_ID');if(!id)throw Error('Missing SPREADSHEET_ID Script Property');return SpreadsheetApp.openById(id)}
function clean_(v,n){return String(v==null?'':v).trim().slice(0,n)}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
/** Run manually once after setting SPREADSHEET_ID. Creates headers only; no fabricated rows. */
function setupSheetStructure(){const ss=sheetDb_();const schemas={Workshops:['id','title_no','title_en','summary_no','summary_en','date_label_no','date_label_en','start_at','end_at','capacity','reserved_count','price','location','drive_file_id','booking_url','status','created_at','updated_at'],Reservations:['id','workshop_id','created_at','name','email','phone','seats','status','confirmation_id','language','payment_status'],Blog:['id','slug','title_no','title_en','summary_no','summary_en','body_no','body_en','cover_file_id','status','published_at','updated_at'],Gallery:['id','title_no','title_en','image_url','drive_file_id','alt_no','alt_en','sort_order','published','created_at'],Testimonials:['id','name_or_initials','text_no','text_en','permission_confirmed','published','sort_order'],ContactMessages:['created_at','name','email','message','language','status'],Newsletter:['created_at','email','language','consent_text','consent_at','status'],AdminAudit:['created_at','admin_email','action','record_type','record_id','details']};Object.entries(schemas).forEach(([name,headers])=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1)}})}
